# Example values only. Copy to .dev.vars for local Pages Functions work; never commit real values.
# Upstream JSON-RPC endpoint the /api/rpc relay forwards to. Devnet default for development.
RPC_UPSTREAM_URL=https://api.devnet.solana.com
# Comma-separated ISO country codes the relay refuses (compliance), e.g. XX,YY
BLOCKED_COUNTRIES=
# Comma-separated origins allowed to call /api/rpc
ALLOWED_ORIGINS=http://localhost:3000
