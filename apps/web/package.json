{
  "name": "@datum/web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm check:tokens && pnpm copy:check && next build",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs",
    "copy:check": "node scripts/copy-check.mjs",
